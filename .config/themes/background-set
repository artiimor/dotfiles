#!/usr/bin/env python3
# Fondo de pantalla del tema actual (como en Omarchy): los de
# ~/.config/themes/<tema>/backgrounds/ y, siempre al final, "pepes" (el prado de siempre).
#
#   background-set           lista: "<fondo>\t<ruta>\t<1 si es el actual>" (menú Super+Ctrl+B)
#   background-set <fondo>   pone ese fondo (nombre de archivo o "pepes")
#   background-set --next    pasa al siguiente (Super+Ctrl+Shift+B)
#   background-set --path    ruta del actual: la pide Theme.qml en cada "theme reload"
#
# El elegido se guarda por tema en ~/.local/state/theme-backgrounds ({tema: fondo});
# sin elegir (o si ya no existe), el primero de la lista.

import json
import os
import sys

sys.dont_write_bytecode = True  # sin __pycache__ en ~/.config/themes
from themelib import HOME, THEMES, current_theme, qs_theme_reload

STATE = f"{HOME}/.local/state/theme-backgrounds"
PEPES = f"{HOME}/.config/backgrounds/wallpaper-desktop.jpg"
EXTS = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif")


def backgrounds(theme):
    # {fondo: ruta}, en orden: los del tema y al final los Pepes
    d = f"{THEMES}/{theme}/backgrounds"
    try:
        files = sorted(f for f in os.listdir(d) if f.lower().endswith(EXTS))
    except OSError:
        files = []
    return {**{f: f"{d}/{f}" for f in files}, "pepes": PEPES}


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def choose(theme, name):
    state = load()
    state[theme] = name
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(state, f, indent=1)
    qs_theme_reload()


def main():
    theme = current_theme() or ""  # sin tema: solo los Pepes
    bgs = backgrounds(theme)
    names = list(bgs)
    cur = load().get(theme)
    if cur not in bgs:
        cur = names[0]
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        for n, p in bgs.items():
            print(f"{n}\t{p}\t{int(n == cur)}")
    elif arg == "--path":
        print(bgs[cur])
    elif arg == "--next":
        choose(theme, names[(names.index(cur) + 1) % len(names)])
    elif arg in bgs:
        choose(theme, arg)
    else:
        sys.exit(f"El tema «{theme}» no tiene el fondo «{arg}». Fondos: {', '.join(names)}")


if __name__ == "__main__":
    main()
