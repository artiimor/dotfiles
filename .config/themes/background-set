#!/usr/bin/env python3
# Wallpaper of the current theme (like in Omarchy): the ones in
# ~/.config/themes/<theme>/backgrounds/ and, always last, "pepes" (the usual meadow).
#
#   background-set           list: "<background>\t<path>\t<1 if current>" (Super+Ctrl+B menu)
#   background-set <name>    sets that background (file name or "pepes")
#   background-set --next    switches to the next one (Super+Ctrl+Shift+B)
#   background-set --path    path of the current one: Theme.qml asks for it on every "theme reload"
#
# The choice is saved per theme in ~/.local/state/theme-backgrounds ({theme: background});
# with no choice (or if it no longer exists), the first one in the list.

import json
import os
import sys

sys.dont_write_bytecode = True  # no __pycache__ in ~/.config/themes
from themelib import HOME, THEMES, current_theme, qs_theme_reload, tr

STATE = f"{HOME}/.local/state/theme-backgrounds"
PEPES = f"{HOME}/.config/backgrounds/wallpaper-desktop.jpg"
EXTS = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif")


def backgrounds(theme):
    # {background: path}, in order: the theme's ones and the Pepes last
    d = f"{THEMES}/{theme}/backgrounds"
    try:
        files = sorted(f for f in os.listdir(d) if f.lower().endswith(EXTS))
    except OSError:
        files = []
    return {**{f: f"{d}/{f}" for f in files}, "pepes": PEPES}


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def choose(theme, name):
    state = load()
    state[theme] = name
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(state, f, indent=1)
    qs_theme_reload()


def main():
    theme = current_theme() or ""  # no theme: only the Pepes
    bgs = backgrounds(theme)
    names = list(bgs)
    cur = load().get(theme)
    if cur not in bgs:
        cur = names[0]
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        for n, p in bgs.items():
            print(f"{n}\t{p}\t{int(n == cur)}")
    elif arg == "--path":
        print(bgs[cur])
    elif arg == "--next":
        choose(theme, names[(names.index(cur) + 1) % len(names)])
    elif arg in bgs:
        choose(theme, arg)
    else:
        sys.exit(tr("The theme “%1” has no background “%2”. Backgrounds: %3", theme, arg, ", ".join(names)))


if __name__ == "__main__":
    main()
