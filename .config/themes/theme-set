#!/usr/bin/env python3
# Cambia el tema de colores de todo el escritorio.
#
#   theme-set              lista los temas (* = el actual)
#   theme-set <tema>       aplica un tema (el nombre de su carpeta)
#   theme-set --reapply    vuelve a generar el tema actual (tras editar su theme.json)
#   theme-set --list       para el menú de Quickshell (Super+T): una línea JSON por tema,
#                          { dir, name, cur, light, bg, fg, colors }
#
# Cada tema es una carpeta en ~/.config/themes con un theme.json. Este script
# lee ese archivo, escribe los colores de cada programa y les avisa:
#
#   Quickshell   lo lee directamente de themes/current/theme.json   (al momento)
#   Hyprland     hypr/config/theme.lua                               (al momento)
#   hyprlock     hypr/hyprlock-colors.conf                           (próximo bloqueo)
#   kitty        kitty/themes/current.conf                           (al momento)
#   Ghostty      ghostty/themes/current (config: theme = current)    (al momento)
#   btop         btop/themes/current.theme                           (al abrirlo)
#   fzf          themes/current-env.sh, cargado desde ~/.bashrc      (terminales nuevas)
#   GTK          gtk-3.0/gtk.css y gtk-4.0/gtk.css (no en el perfil  (al abrir la app)
#                mac-light, que usa uno claro fijo de config-set)
#   Qt / KDE     qt6ct/colors/current.conf, esquema KDE "Theme" y   (al abrir la app)
#                sus colores en kdeglobals (Dolphin)
#   fastfetch    fastfetch/themed/pepe-*.txt: Pepes teñidos con el     (terminales nuevas)
#                acento (los originales los genera fastfetch/pepe.py)
#   Neovim       nvim y lazyvim: colorscheme "tema" (nvim/colors/tema.lua, mini.hues
#                con ui.bg/ui.fg y nvimColors.syn); los abiertos, por su socket
#   Fondo        Quickshell lo pide a background-set al recargar  (al momento)
#
# Temas claros: "light": true en theme.json (sin él, oscuro). Al cambiar de tema
# se llama a sync_theme() de config-set: en Modo Mac pasa a Mac claro u oscuro
# (reinicia Quickshell) y en Modo normal pone GTK e iconos claros u oscuros.
# Desde el menú (Super+T) se lanza con setsid, para que ese reinicio no lo mate.
#
# Los archivos generados empiezan con "Generado por theme-set": no los edites,
# cambia el theme.json del tema y ejecuta `theme-set --reapply`.
#
# Rutas y utilidades comunes con config-set y background-set: themelib.py.

import glob
import json
import re
import os
import subprocess
import sys
import time

sys.dont_write_bytecode = True  # sin __pycache__ en ~/.config/themes
from themelib import (CONF, CURRENT, HOME, QUIET, THEMES, current_theme, list_themes,
                      load_script, load_theme, notify, qs_theme_reload, reload_terminals,
                      run_quiet, saved_profile, tr, write)

HEADER = "Generado por theme-set a partir de themes/{}/theme.json: no editar"


def rgb(hexcolor):
    h = hexcolor.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hypr(hexcolor):
    # "#rrggbb" o "#rrggbbaa" → "rgba(rrggbbaa)"
    h = hexcolor.lstrip("#")
    return f"rgba({h if len(h) == 8 else h + 'ff'})"


# ── Un generador por programa ────────────────────────────────

def gen_hyprland(name, t):
    ui, hy = t["ui"], t["hypr"]
    write(f"{CONF}/hypr/config/theme.lua", f"""-- {HEADER.format(name)}
-- Lo usan decorations.lua, misc.lua y desktopmode.lua

THEME_BORDER   = {{ {", ".join(f'"{hypr(c)}"' for c in hy["border"])} }}
THEME_INACTIVE = "{hypr(hy["inactive"])}"
THEME_GROUP    = "{hypr(hy["group"])}"
THEME_ACCENT   = "{hypr(ui["accent"])}"
THEME_BG       = "{hypr(ui["bg"])}"
THEME_FG       = "{hypr(ui["fg"])}"
""")


def gen_hyprlock(name, t):
    ui, term = t["ui"], t["term"]
    r, g, b = rgb(term["background"])
    c = lambda k: "rgb({}, {}, {})".format(*rgb(ui[k]))
    # $fg/$muted van sobre el fondo de noche: en los temas claros, casi blancos.
    # $fieldfg es el texto del campo de contraseña (sobre $bg): el del tema
    light = t.get("light")
    fg = "rgb(245, 245, 247)" if light else c("fg")
    muted = "rgb(216, 216, 222)" if light else c("muted")
    write(f"{CONF}/hypr/hyprlock-colors.conf", f"""# {HEADER.format(name)}
$bg      = rgba({r}, {g}, {b}, 0.75)
$fg      = {fg}
$muted   = {muted}
$fieldfg = {c("fg")}
$accent  = {c("accent")}
$accent2 = {c("accent2")}
$yellow  = {c("yellow")}
$red     = {c("red")}
""")


def gen_kitty(name, t):
    term, ui = t["term"], t["ui"]
    cols = "\n".join(f"color{i:<2} {c}" for i, c in enumerate(term["colors"]))
    bg = term["background"]
    write(f"{CONF}/kitty/themes/current.conf", f"""# {HEADER.format(name)}
{cols}

background            {bg}
foreground            {term["foreground"]}
cursor                {term["cursor"]}
cursor_text_color     {bg}
cursor_trail_color    {term["cursor"]}
selection_background  {term["selection_background"]}
selection_foreground  {term["selection_foreground"]}
url_color             {term["colors"][6]}

active_border_color   {ui["accent"]}
inactive_border_color {term["colors"][8]}
active_tab_foreground   {bg}
active_tab_background   {ui["accent"]}
inactive_tab_foreground {term["colors"][8]}
inactive_tab_background {bg}
""")


def selection(t):
    # Fondo y texto de la fila elegida en btop y fzf. En los oscuros, colors[0] y
    # colors[15]; en los claros esos dos no sirven (el negro ANSI es oscuro y el
    # blanco claro, como en sus paletas originales): la selección del terminal
    term, c = t["term"], t["term"]["colors"]
    if t.get("light"):
        return term["selection_background"], t["ui"]["fg"]
    return c[0], c[15]


def gen_btop(name, t):
    term, ui = t["term"], t["ui"]
    c = term["colors"]
    box = term["selection_background"]
    sel_bg, sel_fg = selection(t)
    keys = {
        "main_bg": term["background"], "main_fg": term["foreground"],
        "title": c[4], "hi_fg": ui["accent"],
        "selected_bg": sel_bg, "selected_fg": sel_fg,
        "inactive_fg": c[8], "graph_text": c[8], "meter_bg": sel_bg,
        "proc_misc": ui["accent"],
        "cpu_box": box, "mem_box": box, "net_box": box, "proc_box": box,
        "div_line": sel_bg,
        "temp_start": c[6], "temp_mid": c[3], "temp_end": c[1],
        "cpu_start": ui["muted"], "cpu_mid": ui["accent"], "cpu_end": c[4],
        "free_start": box, "free_mid": ui["muted"], "free_end": ui["accent"],
        "cached_start": box, "cached_mid": c[6], "cached_end": c[14],
        "available_start": box, "available_mid": ui["muted"], "available_end": ui["accent"],
        "used_start": c[4], "used_mid": c[5], "used_end": c[1],
        "download_start": box, "download_mid": ui["muted"], "download_end": ui["accent"],
        "upload_start": box, "upload_mid": c[6], "upload_end": c[14],
        "process_start": ui["accent"], "process_mid": c[4], "process_end": c[5],
    }
    body = "\n".join(f'theme[{k}]="{v}"' for k, v in keys.items())
    write(f"{CONF}/btop/themes/current.theme", f"# {HEADER.format(name)}\n{body}\n")


def gen_fzf(name, t):
    term, ui = t["term"], t["ui"]
    c = term["colors"]
    sel_bg, sel_fg = selection(t)
    opts = (f"--color=bg:-1,bg+:{sel_bg},fg:{term['foreground']},fg+:{sel_fg},"
            f"hl:{ui['accent']},hl+:{c[4]},info:{c[8]},prompt:{ui['accent']},"
            f"pointer:{ui['accent']},marker:{c[5]},spinner:{ui['accent']},"
            f"header:{c[8]},border:{term['selection_background']},gutter:-1 "
            f"--pointer=▌ --marker=•")
    write(f"{THEMES}/current-env.sh", f"# {HEADER.format(name)}\nexport FZF_DEFAULT_OPTS=\"{opts}\"\n")


def gen_gtk(name, t):
    # En el perfil "mac-light" el gtk.css claro lo pone config-set: no se pisa
    if saved_profile() == "mac-light":
        return
    g = t["gtk"]
    pairs = [
        ("accent", g["accent"]), ("accent-bg", g["accentBg"]), ("accent-fg", g["accentFg"]),
        ("window-bg", g["window"]), ("window-fg", g["fg"]),
        ("view-bg", g["view"]), ("view-fg", g["fg"]),
        ("headerbar-bg", g["headerbar"]), ("headerbar-fg", g["fg"]),
        ("sidebar-bg", g["view"]), ("sidebar-fg", g["fg"]),
        ("card-bg", g["card"]),
        ("popover-bg", g["headerbar"]), ("popover-fg", g["fg"]),
        ("dialog-bg", g["headerbar"]), ("dialog-fg", g["fg"]),
    ]
    write_gtk_css(f"/* {HEADER.format(name)} */\n", pairs)


def write_gtk_css(head, pairs):
    # gtk.css de GTK 3 y 4 con los colores [(nombre, "#rrggbb")]; lo usa también
    # config-set para el gtk.css claro fijo de mac-light
    old = "\n".join(f"@define-color {k.replace('-', '_')}_color {v};" for k, v in pairs)
    new = "\n".join(f"    --{k}-color: {v};" for k, v in pairs)
    write(f"{CONF}/gtk-3.0/gtk.css", head + old + "\n")
    write(f"{CONF}/gtk-4.0/gtk.css", head + ":root {\n" + new + "\n}\n\n"
          "/* Lo mismo con nombres antiguos, para libadwaita < 1.6 */\n" + old + "\n")


def gen_ghostty(name, t):
    term = t["term"]
    pal = "\n".join(f"palette = {i}={c}" for i, c in enumerate(term["colors"]))
    write(f"{CONF}/ghostty/themes/current", f"""# {HEADER.format(name)}
{pal}
background = {term["background"]}
foreground = {term["foreground"]}
cursor-color = {term["cursor"]}
cursor-text = {term["background"]}
selection-background = {term["selection_background"]}
selection-foreground = {term["selection_foreground"]}
""")


def mix(a, b, k):
    # Color entre a y b (k = 0 → a, k = 1 → b)
    return "#" + "".join(f"{round(x + (y - x) * k):02x}" for x, y in zip(rgb(a), rgb(b)))


def gen_qt(name, t):
    g, ui, c = t["gtk"], t["ui"], t["term"]["colors"]
    fg, dim = g["fg"], c[8]
    # Relieves de Fusion: en los temas oscuros salen de la paleta del terminal; en
    # los claros (ahí colors[15] es el texto oscuro) se calculan desde los botones
    if t.get("light"):
        light, midlight = "#ffffff", mix(g["card"], "#ffffff", 0.5)
        dark, mid, bright = mix(g["card"], fg, 0.45), mix(g["card"], fg, 0.3), "#ffffff"
    else:
        light, midlight, dark, mid, bright = c[15], c[7], ui["bg"], c[8], c[15]

    # qt6ct: los 22 roles de QPalette en su orden
    def roles(text):
        return ", ".join([text, g["card"], light, midlight, dark, mid, text, bright, text,
                          g["window"], g["headerbar"], "#000000", g["accentBg"], g["accentFg"],
                          c[6], ui["accent"], g["card"], g["window"], g["headerbar"], fg, dim,
                          ui["accent"]])
    write(f"{CONF}/qt6ct/colors/current.conf",
          f"; {HEADER.format(name)}\n[ColorScheme]\nactive_colors={roles(fg)}\n"
          f"disabled_colors={roles(dim)}\ninactive_colors={roles(fg)}\n")

    # Esquema KDE (lo usan Dolphin y demás apps KF6)
    def kde(*hexes):
        return ",".join(str(int(x.lstrip("#")[i:i + 2], 16)) for x in hexes for i in (0, 2, 4))
    fgs = (f"DecorationFocus={kde(ui['accent'])}\nDecorationHover={kde(ui['accent'])}\n"
           f"ForegroundActive={kde(ui['accent'])}\nForegroundInactive={kde(dim)}\n"
           f"ForegroundLink={kde(c[6])}\nForegroundNegative={kde(c[1])}\n"
           f"ForegroundNeutral={kde(c[3])}\nForegroundPositive={kde(c[2])}\n"
           f"ForegroundVisited={kde(ui['accent'])}\n")
    def group(header, bg, alt, text=fg):
        return (f"[{header}]\nBackgroundAlternate={kde(alt)}\nBackgroundNormal={kde(bg)}\n"
                f"{fgs}ForegroundNormal={kde(text)}\n\n")
    colors = (
        group("Colors:Button", g["card"], g["headerbar"])
        + group("Colors:Complementary", g["window"], g["card"])
        + group("Colors:Header", g["headerbar"], g["window"])
        + group("Colors:Header][Inactive", g["window"], g["headerbar"])
        + group("Colors:Selection", g["accentBg"], g["accentBg"], g["accentFg"])
        + group("Colors:Tooltip", g["headerbar"], g["window"])
        + group("Colors:View", g["window"], g["card"])
        + group("Colors:Window", g["headerbar"], g["card"])
        + f"[WM]\nactiveBackground={kde(g['headerbar'])}\nactiveBlend={kde(ui['accent'])}\n"
          f"activeForeground={kde(fg)}\ninactiveBackground={kde(g['window'])}\n"
          f"inactiveBlend={kde(dim)}\ninactiveForeground={kde(dim)}\n"
    )
    write(f"{HOME}/.local/share/color-schemes/Theme.colors",
          f"# {HEADER.format(name)}\n[General]\nColorScheme=Theme\nName={tr('Current theme')}\n\n{colors}")

    # kdeglobals: se conservan las demás secciones y se cambian solo las de color
    path = f"{CONF}/kdeglobals"
    keep, skip = [], False
    for line in (open(path).read().splitlines() if os.path.exists(path) else []):
        if line.startswith("["):
            skip = line.startswith(("[Colors:", "[ColorEffects:", "[WM]"))
        if not skip:
            keep.append(line)
    write(path, "\n".join(keep).rstrip() + "\n\n" + colors)


def gen_fastfetch(name, t):
    # Mezcla cada color del Pepe con el acento a su misma luminosidad. Cuanto menos
    # saturado es el acento, más se tiñe (con el gris de basalt queda casi en grises).
    acc = rgb(t["ui"]["accent"])
    lum = lambda c: 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
    sat = (max(acc) - min(acc)) / max(max(acc), 1)
    k = 0.4 + 0.4 * (1 - sat)
    la = max(lum(acc), 1)

    def tint(m):
        c = [int(x) for x in m.group(2).split(";")]
        l = lum(c)
        out = [round(min(255, (1 - k) * x + k * a * l / la)) for x, a in zip(c, acc)]
        return f"{m.group(1)};2;{out[0]};{out[1]};{out[2]}m"

    src = f"{CONF}/fastfetch"
    for f in sorted(os.listdir(src)):
        if f.startswith("pepe-") and f.endswith(".txt"):
            text = open(f"{src}/{f}").read()
            write(f"{src}/themed/{f}", re.sub(r"\x1b\[(38|48);2;(\d+;\d+;\d+)m",
                                             lambda m: "\x1b[" + tint(m), text))


GENERATORS = [gen_hyprland, gen_hyprlock, gen_kitty, gen_ghostty, gen_btop, gen_fzf, gen_gtk, gen_qt, gen_fastfetch]


# ── Avisar a los programas que ya están abiertos ─────────────

def sync_profile():
    # config-set ajusta el perfil a la claridad del tema (ver su sync_theme).
    # True si ha reiniciado Quickshell y recargado Hyprland
    path = f"{THEMES}/config-set"
    if not os.path.isfile(path):
        return False
    return load_script("config-set").sync_theme()


def reload_all(restarted=False):
    if not restarted:  # si config-set ha reiniciado qs y Hyprland, ya leen el tema nuevo
        qs_theme_reload()
        run_quiet(["hyprctl", "reload"])


def reload_nvim(t):
    # Cada Neovim abierto escucha en $XDG_RUNTIME_DIR/nvim.<pid>.0
    # Primero background: si no, al pasar de un tema claro a uno oscuro se quedaría
    # en light y rose-pine, gruvbox, everforest... cargarían su variante clara
    cs = t.get("nvim", "catppuccin")
    bg = "light" if t.get("light") else "dark"
    # Los dos Neovim (mini.nvim y lazyvim) usan el colorscheme "tema", que define
    # MiniThemeReload() y relee theme.json él solo; si no está (otro colorscheme
    # cargado desde fuera), se manda background + campo "nvim"
    expr = (f"exists('*MiniThemeReload') ? MiniThemeReload() : "
            f"execute(['set background={bg}', 'colorscheme {cs}'])")
    # Todos a la vez (antes uno detrás de otro, y uno colgado retrasaba al resto)
    procs = [subprocess.Popen(["nvim", "--server", sock, "--remote-expr", expr], **QUIET)
             for sock in glob.glob(f"{os.environ.get('XDG_RUNTIME_DIR', '/tmp')}/nvim.*.0")]
    for p in procs:
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            p.kill()  # socket muerto de un nvim que se cerró mal


def apply(name):
    t = load_theme(name)
    tmp = CURRENT + ".tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(name, tmp)
    os.replace(tmp, CURRENT)
    for gen in GENERATORS:
        gen(name, t)
    # Lo primero tras escribir los archivos: así las terminales cambian a la vez que
    # el resto y no esperan al reinicio de Quickshell de sync_profile
    reload_terminals()
    reload_nvim(t)
    restarted = sync_profile()
    reload_all(restarted)
    if restarted:
        time.sleep(1.5)  # que el Quickshell nuevo tenga ya el servidor de notificaciones
    notify(tr("Theme"), tr("Color theme"), t.get("name", name))


def print_list():
    # --list: el menú de temas de Quickshell (Super+T). Cada fila lleva su paleta
    # (fondo y texto del terminal, acento y 6 colores ANSI) y si es claro; los
    # theme.json que no se pueden leer se saltan
    cur = current_theme()
    for d in list_themes():
        try:
            j = load_theme(d)
            term, c = j["term"], j["term"]["colors"]
            print(json.dumps({"dir": d, "name": j.get("name", d), "cur": d == cur,
                              "light": bool(j.get("light")),
                              "bg": term["background"], "fg": term["foreground"],
                              "colors": [j["ui"]["accent"]] + c[1:7]}))
        except (OSError, ValueError, KeyError, IndexError):
            pass


def main():
    args = sys.argv[1:]
    if not args:
        cur = current_theme()
        for d in list_themes():
            print(("* " if d == cur else "  ") + d)
        return
    if args[0] == "--list":
        print_list()
        return
    name = current_theme() if args[0] == "--reapply" else args[0]
    if name not in list_themes():
        sys.exit(tr("There is no theme “%1”. Themes: %2", name, ", ".join(list_themes())))
    apply(name)


if __name__ == "__main__":
    main()
