#!/usr/bin/env python3
# Monospace font for the whole desktop, separate from the color theme (not in
# theme.json: changing theme or `theme-set --reapply` don't touch it).
#
#   font-set              lists the fonts (* = the current one)
#   font-set <family>     applies it, e.g. font-set "JetBrainsMono Nerd Font"
#   font-set --list       for the Quickshell menu (Super+T, Font tab): one
#                         JSON line per font, { font, cur }
#
# The fonts are the installed monospace Nerd Fonts, one per family (without
# the "Mono" variants, with narrow icons, or "Propo"). The choice is saved in
# ~/.local/state/font and a small file is written per program, which its config
# includes after its default font (with none chosen, that one stays):
#
#   Ghostty     ghostty/font.ghostty (config-file in config.ghostty)   (instantly)
#   hyprbars    hypr/font.conf      (read by desktopmode.lua, Normal Mode) (instantly)
#
# hyprbars uses the "Propo" (proportional) variant if installed. hyprlock (only
# a fallback if Quickshell isn't running) keeps JetBrains Mono.
# The Quickshell UI and Mac Mode keep their sans font (Theme.qml).
#
# Paths and utilities shared with theme-set: themelib.py.

import json
import subprocess
import sys

sys.dont_write_bytecode = True  # no __pycache__ in ~/.config/themes
from themelib import CONF, HOME, notify, read_state, reload_terminals, run_quiet, tr, write

STATE = f"{HOME}/.local/state/font"
HEADER = "Generado por font-set: no editar, elige la fuente con font-set (Super+T, Fuente)"


def installed():
    # {family: is monospace}, with the first name of each family from fc-list
    out = subprocess.run(["fc-list", "--format", "%{family[0]}\t%{spacing}\n"],
                         capture_output=True, text=True).stdout
    fams = {}
    for line in out.splitlines():
        fam, _, spacing = line.partition("\t")
        # 100 = mono, 90 = dual (mono with double-width glyphs: Iosevka, Zed Mono)
        fams[fam] = fams.get(fam, False) or spacing in ("90", "100")
    return fams


def families(fams):
    # Monospace Nerd Fonts, without the "... Nerd Font Mono/Propo" variants.
    # Some (patched Monaco) don't declare spacing: valid if their Mono variant is mono
    return sorted(f for f, mono in fams.items()
                  if f.endswith(" Nerd Font") and (mono or fams.get(f"{f} Mono")))


def apply(fam, fams):
    propo = f"{fam} Propo" if f"{fam} Propo" in fams else fam
    write(STATE, fam + "\n")
    write(f"{CONF}/ghostty/font.ghostty", f"# {HEADER}\nfont-family = {fam}\n")
    write(f"{CONF}/hypr/font.conf", f"# {HEADER}\n{propo}\n")
    reload_terminals()  # Ghostty re-reads its config
    run_quiet(["hyprctl", "reload"])  # hyprbars
    notify(tr("Font"), tr("Font"), fam)


def main():
    fams = installed()
    names = families(fams)
    cur = read_state(STATE)
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        for f in names:
            print(("* " if f == cur else "  ") + f)
    elif arg == "--list":
        for f in names:
            print(json.dumps({"font": f, "cur": f == cur}))
    elif arg in names:
        apply(arg, fams)
    else:
        sys.exit(tr("The font “%1” is not installed. Fonts: %2", arg, ", ".join(names)))


if __name__ == "__main__":
    main()
