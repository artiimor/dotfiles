#!/usr/bin/env python3
# Increase contrast (like macOS Accessibility's "Increase contrast"): no
# transparency or blur, thicker and opaque window borders, more marked secondary
# text and bar borders, and GTK/libadwaita high contrast.
#
#   contrast-set            says whether it's on ("on" or "off")
#   contrast-set on|off     turns it on or off
#   contrast-set toggle     toggles it (bar button and Control Center tile)
#
# Works with both profiles (Mac Mode and Normal Mode) and with any theme.
# The state is saved in ~/.local/state/increased-contrast ("1" or "0") and read by:
#
#   Hyprland     hypr/config/profile.lua → CONTRAST (borders,      (hyprctl reload)
#                blur and hyprbars in decorations.lua and desktopmode.lua)
#   Quickshell   Theme.qml and macshell/Theme.qml                 (watch the file)
#
# Terminals (Ghostty, btop, fzf) and Neovim raise the contrast of their colors:
# theme-set regenerates them with themelib.boost_contrast() and Neovim applies it on its own when
# reading the theme (nvim/lua/tema/theme.lua). Ghostty and Neovim, instantly; btop and
# fzf, when opened.
#
# It also sets org.gnome.desktop.a11y.interface high-contrast, which the portal
# (xdg-desktop-portal-gtk) publishes as org.freedesktop.appearance contrast:
# GTK4/libadwaita apps switch instantly. Qt apps don't.

import os
import sys

sys.dont_write_bytecode = True  # no __pycache__ in ~/.config/themes
from themelib import (CONTRAST_STATE as STATE, current_theme, load_script, load_theme,
                      notify, read_state, reload_terminals, run_quiet, tr, write_atomic)


def enabled():
    return read_state(STATE) == "1"


def apply(on):
    write_atomic(STATE, "1\n" if on else "0\n")
    run_quiet(["gsettings", "set", "org.gnome.desktop.a11y.interface", "high-contrast",
               "true" if on else "false"])
    name = current_theme()
    if name:
        theme_set = load_script("theme-set")
        t = load_theme(name)
        theme_set.gen_terminals(name, t)
        reload_terminals()
        theme_set.reload_nvim(t)
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run_quiet(["hyprctl", "reload"])
    notify(tr("Increase contrast"), tr("Increase contrast"), tr("On") if on else tr("Off"))


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        print("on" if enabled() else "off")
    elif arg in ("on", "off", "toggle"):
        apply(not enabled() if arg == "toggle" else arg == "on")
    else:
        print(tr("Usage: contrast-set [on|off|toggle]"), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
