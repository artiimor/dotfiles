// Se ejecuta al abrir fish (fish_greeting de cachyos-fish-config)
// Colores ANSI de kitty: blue = lavanda #a99bd6, magenta = rosa suave, cyan, green...
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Logo: Pepe en ASCII (lo genera pepe.py). ~/.bashrc elige un pepe-*.txt al azar;
  // este es el que sale si se lanza fastfetch a mano
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/pepe-mago.txt",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" },
    "key": { "width": 5 }
  },
  "modules": [
    // Saltos para bajar la info y que quede al lado de la túnica, no del sombrero
    "break", "break", "break", "break", "break", "break", "break", "break", "break", "break", "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────" },
    { "type": "os", "key": "󰣇", "format": "{pretty-name}" },
    { "type": "kernel", "key": "", "format": "{release}" },
    { "type": "wm", "key": "", "format": "{pretty-name}" },
    { "type": "terminal", "key": "", "format": "{pretty-name}" },
    { "type": "shell", "key": "", "format": "{pretty-name}" },
    { "type": "packages", "key": "󰏖", "format": "{all} packages" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────" },
    { "type": "cpu", "key": "", "format": "{name:-28}" },
    { "type": "gpu", "key": "󰢮", "format": "{name:-28}" },
    { "type": "memory", "key": "", "keyColor": "magenta" },
    { "type": "disk", "key": "󰋊", "keyColor": "magenta", "folders": "/" },
    { "type": "battery", "key": "󰁹", "keyColor": "magenta", "format": "{capacity} · {status}" },
    { "type": "uptime", "key": "󰅐", "keyColor": "magenta" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 5 }
  ]
}
