# One variable per line, `export K=V`: hypr/config/environment.lua reads this file
# so the "Hyprland" session without uwsm gets the same ones. TERM isn't set here: each terminal sets it.
# wasdjy scripts (wasdjy-theme, wasdjy-config...): the repo lives in ~/.local/share/wasdjy
export PATH="$HOME/.local/share/wasdjy/bin:$PATH"
export BROWSER=brave
# Claude Code without the spinner in the title: it changed it several times per second and made
# hyprbars/Hyprland redraw constantly
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
export QT_QPA_PLATFORM="wayland;xcb"
# Qt with qt6ct: Breeze style, Sur-Transparente icons and mac-dark colors (qt6ct/colors/mac-dark.conf).
# KDE apps (Dolphin) also read ~/.config/kdeglobals. Plasma is no longer installed.
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="macOS"  # black macOS arrow (apple_cursor; installed by install.sh)
export XCURSOR_SIZE=24


# NVIDIA: install.sh detects the GPU and, if NVIDIA is the primary one, writes
# its variables to env.d/gpu (not to this file). On a hybrid laptop it doesn't set them.
