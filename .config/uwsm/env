# Una variable por línea, `export K=V`: hypr/config/environment.lua lee este archivo
# para que la sesión "Hyprland" sin uwsm tenga las mismas. TERM no se fija aquí: lo pone cada terminal.
export BROWSER=brave
# Claude Code sin spinner en el título: lo cambiaba varias veces por segundo y hacía
# redibujar hyprbars/Hyprland sin parar
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
export QT_QPA_PLATFORM="wayland;xcb"
# Qt con qt6ct: estilo Breeze, iconos Sur-Transparente y colores mac-dark (qt6ct/colors/mac-dark.conf).
# Las apps KDE (Dolphin) leen además ~/.config/kdeglobals. Plasma ya no está instalado.
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="macOS"  # flecha negra de macOS (apple_cursor; lo instala install.sh)
export XCURSOR_SIZE=24


# NVIDIA: install.sh detecta la gráfica y, si NVIDIA es la principal, escribe
# sus variables en env.d/gpu (no en este archivo). En un portátil híbrido no las pone.
