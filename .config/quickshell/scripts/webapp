#!/usr/bin/env bash
# Creates or removes webapps: a .desktop in ~/.local/share/applications that opens the
# site in its own browser window (--app=URL), with its icon in icons/.
# The questions go through the Quickshell launcher (dmenu-qs, in this folder),
# which works the same in Normal Mode and in Mac Mode. Called by the launcher's
# "Create webapp" and "Remove webapp" entries.
#
#   webapp            asks for name, URL and icon (URL of an image or the site's own)
#   webapp --remove   pick a webapp and delete it, with its icon

APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICONS="$APPS/icons"
menu() { "$(dirname "$0")/dmenu-qs" -c -p "$1"; }
# Translation (see themelib.py): t "Text %1" arg
t() { python3 "$HOME/.local/share/wasdjy/lib/themelib.py" tr "$@"; }
say() { notify-send -a Webapps "$@"; }
fail() { say -u critical "$(t "Could not do it")" "$1"; exit 1; }

# Asks to choose "Yes, $1" versus "No"
confirm() {
	local yes
	yes=$(t "Yes, %1" "$1")
	[ "$(printf '%s\n%s\n' "$(t No)" "$yes" | menu "$(t "Are you sure?")")" = "$yes" ]
}

# Value of a key in a .desktop
field() { sed -n "s/^$2=//p" "$1" | head -n 1; }

# Downloads an image ($1) to $ICONS/$2.<ext> and prints the path; fails if it isn't one
fetch_icon() {
	local tmp ext
	tmp=$(mktemp) || return 1
	if curl -fsL --max-time 10 --max-filesize 5000000 -o "$tmp" -- "$1"; then
		case $(file -b --mime-type "$tmp") in
			image/png) ext=png ;;
			image/svg+xml) ext=svg ;;
			image/jpeg) ext=jpg ;;
			image/x-icon | image/vnd.microsoft.icon) ext=ico ;;
		esac
	fi
	if [ -z "$ext" ]; then
		rm -f "$tmp"
		return 1
	fi
	mkdir -p "$ICONS"
	chmod 644 "$tmp"
	mv "$tmp" "$ICONS/$2.$ext" && printf '%s\n' "$ICONS/$2.$ext"
}

remove() {
	local files=() names=() f choice i
	for f in "$APPS"/*.desktop; do
		grep -q -- '--app=' "$f" 2>/dev/null || continue
		files+=("$f")
		names+=("$(field "$f" Name)")
	done
	[ ${#files[@]} -gt 0 ] || fail "$(t "There are no webapps")"
	choice=$(printf '%s\n' "${names[@]}" | menu "$(t "Remove webapp")") || exit 0
	for i in "${!names[@]}"; do
		[ "${names[$i]}" = "$choice" ] || continue
		confirm "$(t "delete %1" "$choice")" || exit 0
		f=$(field "${files[$i]}" Icon)
		# The icon is only deleted if it's one of ours
		case $f in "$ICONS"/*) rm -f -- "$f" ;; esac
		rm -f -- "${files[$i]}"
		say "$(t "Webapp deleted")" "$choice"
		exit 0
	done
	fail "$(t "There is no webapp “%1”" "$choice")"
}

create() {
	local name url icon slug host browser file arg dirs d
	name=$(menu "$(t "Webapp name")" </dev/null) || exit 0
	name=$(printf '%s' "$name" | tr -d '[:cntrl:]' | sed 's/^ *//; s/ *$//')
	[ -n "$name" ] || fail "$(t "The name is empty")"

	url=$(menu "$(t "URL (e.g. youtube.com)")" </dev/null) || exit 0
	[[ $url =~ ^[[:alpha:]]+:// ]] || url="https://$url"  # no scheme: https:// by default
	[[ $url =~ ^https?://[^/[:space:]]+[^[:space:][:cntrl:]]*$ ]] || fail "$(t "Invalid URL")"
	host=${url#*://}
	host=${host%%[/?#]*}
	host=${host##*@}

	# File name: only [a-z0-9-], so it can't contain / or ..
	slug=$(printf '%s' "$name" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]' |
		sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//')
	[ -n "$slug" ] || fail "$(t "The name needs at least one letter or number")"
	file="$APPS/$slug.desktop"
	if [ -e "$file" ]; then
		grep -q -- '--app=' "$file" || fail "$(t "There is already an application called %1" "$slug.desktop")"
		confirm "$(t "replace “%1”" "$(field "$file" Name)")" || exit 0
	fi
	# One with the same name in the system would be hidden by this one
	IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
	for d in "${dirs[@]}"; do
		[ -e "$d/applications/$slug.desktop" ] && fail "$(t "There is already a system application called %1" "$slug.desktop")"
	done

	# Browser: the one the usual webapps use or, if not, another Chromium
	for browser in brave chromium google-chrome-stable ""; do
		[ -n "$browser" ] && command -v "$browser" >/dev/null && break
	done
	[ -n "$browser" ] || fail "$(t "Brave or Chromium is needed")"

	icon=$(printf '%s\n' "$(t "Automatic (the site's favicon)")" | menu "$(t "Icon URL (png, svg…)")") || exit 0
	[[ $icon =~ ^https?:// ]] || icon=""
	rm -f -- "$ICONS/$slug".{png,svg,jpg,ico}
	icon=$({ [ -n "$icon" ] && fetch_icon "$icon" "$slug"; } ||
		fetch_icon "${url%%://*}://$host/apple-touch-icon.png" "$slug" ||
		fetch_icon "${url%%://*}://$host/favicon.ico" "$slug" || echo web-browser)

	# Exec per the desktop-entry spec: inside quotes
	# \ " ` $ are escaped with \, and then, being a string-type value, each \ is doubled; % becomes %%
	arg=$(printf '%s' "$url" | sed 's/[\\"`$]/\\&/g; s/\\/\\\\/g; s/%/%%/g')
	mkdir -p "$APPS"
	cat >"$file" <<-EOF
		[Desktop Entry]
		Name=${name//\\/\\\\}
		Comment=${name//\\/\\\\}
		Exec=$browser --new-window --ozone-platform=wayland --app="$arg"
		Icon=$icon
		Terminal=false
		Type=Application
		StartupNotify=true
	EOF
	say -i "$icon" "$(t "Webapp created")" "$(t "%1 is now in the launcher" "$name")"
}

case $1 in
	--remove) remove ;;
	"") create ;;
	*) echo "$(t "Usage: %1" "webapp [--remove]")" >&2; exit 2 ;;
esac
