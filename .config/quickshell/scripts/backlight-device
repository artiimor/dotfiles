#!/bin/sh
# Backlit panel controlled by the normal bar (services/Brightness.qml) and
# macshell (macshell/Sys.qml): prints its path in /sys/class/backlight, or nothing if
# there is none (desktop). By type raw > platform > firmware, so a dead
# acpi_video0 isn't picked if there is intel_backlight.
for t in raw platform firmware; do
    for d in /sys/class/backlight/*; do
        [ -r "$d/brightness" ] && [ "$(cat "$d/type" 2>/dev/null)" = "$t" ] && { echo "$d"; exit; }
    done
done
