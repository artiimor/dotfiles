#!/usr/bin/env bash
# dmenu made with Quickshell: reads options from stdin and writes the chosen one to
# stdout (exits with 1 if you cancel). Used by networkmanager_dmenu, bzmenu and webapp.
#
#   printf 'one\ntwo\n' | dmenu-qs -p "Pick"
#   dmenu-qs -P -p "Password" < /dev/null      (hides what you type)
#   dmenu-qs -c -p "URL" < /dev/null             (centered, not under the bar)
#
# networkmanager_dmenu only passes the prompt and the password option to the
# launchers it knows, so it is called through the "wmenu" link in
# this folder, which accepts the same options (-p, -P).

prompt=""
password=false
center=false
while [ $# -gt 0 ]; do
    case "$1" in
        -p | --prompt) prompt="$2"; shift ;;
        -P | --password) password=true ;;
        -c | --center) center=true ;;
    esac
    shift
done

dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/qs-dmenu.XXXXXX") || exit 1
trap 'rm -rf "$dir"' EXIT

cat > "$dir/items"
mkfifo "$dir/out"

qs ipc call launcher dmenu "$dir" "$prompt" "$password" "$center" >/dev/null || exit 1

# If Quickshell reloads or restarts while you wait, the new launcher doesn't
# know about this request and nobody would write to the fifo: after 10 min it is
# considered cancelled, so the script isn't left hanging forever
result=$(timeout 600 cat "$dir/out")
[ -n "$result" ] || exit 1
printf '%s\n' "$result"
