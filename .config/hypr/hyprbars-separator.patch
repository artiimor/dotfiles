+    // line between the bar and the window
+    CHyprColor separator = configColor(g_pGlobalState->config.separatorColor->value());
+    if (separator.a > 0) {
+        separator.a *= a;
+        const double lineH = std::max(1.0, sc<double>(std::round(pMonitor->m_scale)));
+        CBox         lineBox = {titleBarBox.x, titleBarBox.y + std::round(BARBUF.y) - lineH, titleBarBox.w, lineH};
+        g_pHyprOpenGL->renderRect(ctx, lineBox, separator, {});
+    }
+
     m_bWindowSizeChanged = false;
     m_bTitleColorChanged = false;
 
