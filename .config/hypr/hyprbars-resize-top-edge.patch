+// patch local: borde/esquina (Layout::eRectCorner) que redimensiona bajo COORDS (relativas a la barra), o CORNER_NONE.
+// La zona es la franja de bar_resize_edge px de arriba de la barra, lo que sobresale por encima
+// (border_size + extend_border_grab_area, como los otros bordes) y los lados de la barra que
+// Hyprland no cubre (él solo mira alrededor de la superficie de la ventana, sin la barra).
+uint8_t CHyprBar::resizeEdgeAt(const Vector2D& COORDS) {
+    static auto PRESIZEONBORDER   = CConfigValue<Config::INTEGER>("general:resize_on_border");
+    static auto PBORDERSIZE       = CConfigValue<Config::INTEGER>("general:border_size");
+    static auto PBORDERGRABEXTEND = CConfigValue<Config::INTEGER>("general:extend_border_grab_area");
+    const auto  EDGE              = g_pGlobalState->config.barResizeEdge->value();
+    const auto  HEIGHT            = g_pGlobalState->config.barHeight->value();
+
+    if (EDGE <= 0 || !*PRESIZEONBORDER || m_hidden || !g_pGlobalState->config.enabled->value() || !validMapped(m_pWindow))
+        return Layout::CORNER_NONE;
+
+    const auto PWINDOW = m_pWindow.lock();
+    if (Fullscreen::controller()->isFullscreen(PWINDOW) || PWINDOW->backend().traits().overrideRedirect)
+        return Layout::CORNER_NONE;
+
+    const double GRAB   = *PBORDERSIZE + *PBORDERGRABEXTEND;
+    const double W      = assignedBoxGlobal().w;
+    const double CORNER = GRAB + 10;
+
+    if (COORDS.x < -GRAB || COORDS.x >= W + GRAB || COORDS.y < -GRAB)
+        return Layout::CORNER_NONE;
+
+    const bool TOP  = COORDS.y < EDGE;
+    const bool SIDE = (COORDS.x < 0 || COORDS.x >= W) && COORDS.y < HEIGHT - GRAB;
+    if (!TOP && !SIDE)
+        return Layout::CORNER_NONE;
+
+    // el cursor tiene que estar sobre esta ventana, no sobre otra que la tape ni sobre un popup suyo
+    const auto MOUSE = g_pInputManager->getMouseCoordsInternal();
+    if (PWINDOW->hasPopupAt(MOUSE))
+        return Layout::CORNER_NONE;
+    Desktop::CViewHitTester hitTester{*Desktop::viewState()};
+    if (hitTester.windowAt(MOUSE, Desktop::View::RESERVED_EXTENTS | Desktop::View::INPUT_EXTENTS | Desktop::View::ALLOW_FLOATING) != PWINDOW)
+        return Layout::CORNER_NONE;
+
+    if (COORDS.x < CORNER)
+        return Layout::CORNER_TOPLEFT;
+    if (COORDS.x >= W - CORNER)
+        return Layout::CORNER_TOPRIGHT;
+    return Layout::CORNER_TOP;
+}
