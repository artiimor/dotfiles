#!/usr/bin/env python3
# Changes the color theme of the whole desktop.
#
#   wasdjy-theme              lists the themes (* = the current one)
#   wasdjy-theme <theme>      applies a theme (its folder name)
#   wasdjy-theme --reapply    regenerates the current theme (after editing its theme.json)
#   wasdjy-theme --list       for the Quickshell menu (Super+T): one JSON line per theme,
#                          { dir, name, cur, light, bg, fg, colors }
#
# Each theme is a folder in ~/.config/themes with a theme.json. This script
# reads that file, writes the colors for each program and notifies them:
#
#   Quickshell   reads it directly from themes/current/theme.json   (instantly)
#   Hyprland     hypr/config/theme.lua                               (instantly)
#   hyprlock     hypr/hyprlock-colors.conf                           (next lock)
#   Ghostty      ghostty/themes/current (config: theme = current)    (instantly)
#   btop         btop/themes/current.theme                           (when opened)
#   fzf          themes/current-env.sh, sourced from ~/.bashrc       (new terminals)
#   GTK          gtk-3.0/gtk.css and gtk-4.0/gtk.css (not in the     (when the app opens)
#                mac-light profile, which uses a fixed light one from wasdjy-config)
#   Qt / KDE     qt6ct/colors/current.conf, "Theme" KDE scheme and  (when the app opens)
#                its colors in kdeglobals (Dolphin)
#   fastfetch    fastfetch/themed/pepe-*.txt: Pepes tinted with the     (new terminals)
#                accent (the originals are generated by fastfetch/pepe.py)
#   Neovim       nvim and lazyvim: "tema" colorscheme (nvim/colors/tema.lua, mini.hues
#                with ui.bg/ui.fg and nvimColors.syn); open ones, through their socket
#   Contrast     with wasdjy-contrast on, terminals and Neovim get the colors
#                with more contrast (themelib.boost_contrast)
#   Background   Quickshell asks wasdjy-background for it on reload  (instantly)
#
# Light themes: "light": true in theme.json (without it, dark). When the theme changes
# wasdjy-config's sync_theme() is called: in Mac Mode it switches to Mac light or dark
# (instantly, without restarting Quickshell) and in Normal Mode it sets light or dark
# GTK and icons.
#
# Generated files start with "Generado por wasdjy-theme": don't edit them,
# change the theme's theme.json and run `wasdjy-theme --reapply`.
#
# Paths and utilities shared with wasdjy-config and wasdjy-background: themelib.py.

import glob
import json
import re
import os
import subprocess
import sys

sys.dont_write_bytecode = True  # no __pycache__ in lib/
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from themelib import (BIN, CONF, CONTRAST_THEME, CURRENT, HOME, NO_RELOAD, QUIET, THEMES,
                      boost_contrast, contrast_on, current_theme, list_themes, load_script,
                      load_theme, mix, notify, qs_theme_reload, reload_terminals, rgb,
                      run_quiet, saved_profile, tr, write, write_atomic)

HEADER = "Generado por wasdjy-theme a partir de themes/{}/theme.json: no editar"


def hypr(hexcolor):
    # "#rrggbb" or "#rrggbbaa" → "rgba(rrggbbaa)"
    h = hexcolor.lstrip("#")
    return f"rgba({h if len(h) == 8 else h + 'ff'})"


# ── One generator per program ────────────────────────────────

def gen_hyprland(name, t):
    ui, hy = t["ui"], t["hypr"]
    write(f"{CONF}/hypr/config/theme.lua", f"""-- {HEADER.format(name)}
-- Used by decorations.lua, misc.lua and desktopmode.lua

THEME_BORDER   = {{ {", ".join(f'"{hypr(c)}"' for c in hy["border"])} }}
THEME_INACTIVE = "{hypr(hy["inactive"])}"
THEME_GROUP    = "{hypr(hy["group"])}"
THEME_ACCENT   = "{hypr(ui["accent"])}"
THEME_BG       = "{hypr(ui["bg"])}"
THEME_FG       = "{hypr(ui["fg"])}"
""")


def gen_hyprlock(name, t):
    ui, term = t["ui"], t["term"]
    r, g, b = rgb(term["background"])
    c = lambda k: "rgb({}, {}, {})".format(*rgb(ui[k]))
    # $fg/$muted go over the night background: in light themes, almost white.
    # $fieldfg is the password field text (over $bg): the theme's
    light = t.get("light")
    fg = "rgb(245, 245, 247)" if light else c("fg")
    muted = "rgb(216, 216, 222)" if light else c("muted")
    write(f"{CONF}/hypr/hyprlock-colors.conf", f"""# {HEADER.format(name)}
$bg      = rgba({r}, {g}, {b}, 0.75)
$fg      = {fg}
$muted   = {muted}
$fieldfg = {c("fg")}
$accent  = {c("accent")}
$accent2 = {c("accent2")}
$yellow  = {c("yellow")}
$red     = {c("red")}
""")


def selection(t):
    # Background and text of the selected row in btop and fzf. In dark themes, colors[0] and
    # colors[15]; in light ones those two don't work (ANSI black is dark and
    # white is light, as in their original palettes): the terminal selection
    term, c = t["term"], t["term"]["colors"]
    if t.get("light"):
        return term["selection_background"], t["ui"]["fg"]
    return c[0], c[15]


def gen_btop(name, t):
    term, ui = t["term"], t["ui"]
    c = term["colors"]
    box = term["selection_background"]
    sel_bg, sel_fg = selection(t)
    keys = {
        "main_bg": term["background"], "main_fg": term["foreground"],
        "title": c[4], "hi_fg": ui["accent"],
        "selected_bg": sel_bg, "selected_fg": sel_fg,
        "inactive_fg": c[8], "graph_text": c[8], "meter_bg": sel_bg,
        "proc_misc": ui["accent"],
        "cpu_box": box, "mem_box": box, "net_box": box, "proc_box": box,
        "div_line": sel_bg,
        "temp_start": c[6], "temp_mid": c[3], "temp_end": c[1],
        "cpu_start": ui["muted"], "cpu_mid": ui["accent"], "cpu_end": c[4],
        "free_start": box, "free_mid": ui["muted"], "free_end": ui["accent"],
        "cached_start": box, "cached_mid": c[6], "cached_end": c[14],
        "available_start": box, "available_mid": ui["muted"], "available_end": ui["accent"],
        "used_start": c[4], "used_mid": c[5], "used_end": c[1],
        "download_start": box, "download_mid": ui["muted"], "download_end": ui["accent"],
        "upload_start": box, "upload_mid": c[6], "upload_end": c[14],
        "process_start": ui["accent"], "process_mid": c[4], "process_end": c[5],
    }
    body = "\n".join(f'theme[{k}]="{v}"' for k, v in keys.items())
    write(f"{CONF}/btop/themes/current.theme", f"# {HEADER.format(name)}\n{body}\n")


def gen_fzf(name, t):
    term, ui = t["term"], t["ui"]
    c = term["colors"]
    sel_bg, sel_fg = selection(t)
    opts = (f"--color=bg:-1,bg+:{sel_bg},fg:{term['foreground']},fg+:{sel_fg},"
            f"hl:{ui['accent']},hl+:{c[4]},info:{c[8]},prompt:{ui['accent']},"
            f"pointer:{ui['accent']},marker:{c[5]},spinner:{ui['accent']},"
            f"header:{c[8]},border:{term['selection_background']},gutter:-1 "
            f"--pointer=▌ --marker=•")
    write(f"{THEMES}/current-env.sh", f"# {HEADER.format(name)}\nexport FZF_DEFAULT_OPTS=\"{opts}\"\n")


def gen_gtk(name, t):
    # In the "mac-light" profile the light gtk.css is set by wasdjy-config: not overwritten
    if saved_profile() == "mac-light":
        return
    g = t["gtk"]
    pairs = [
        ("accent", g["accent"]), ("accent-bg", g["accentBg"]), ("accent-fg", g["accentFg"]),
        ("window-bg", g["window"]), ("window-fg", g["fg"]),
        ("view-bg", g["view"]), ("view-fg", g["fg"]),
        ("headerbar-bg", g["headerbar"]), ("headerbar-fg", g["fg"]),
        ("sidebar-bg", g["view"]), ("sidebar-fg", g["fg"]),
        ("card-bg", g["card"]),
        ("popover-bg", g["headerbar"]), ("popover-fg", g["fg"]),
        ("dialog-bg", g["headerbar"]), ("dialog-fg", g["fg"]),
    ]
    write_gtk_css(f"/* {HEADER.format(name)} */\n", pairs)


def write_gtk_css(head, pairs):
    # GTK 3 and 4 gtk.css with the colors [(name, "#rrggbb")]; also used by
    # wasdjy-config for mac-light's fixed light gtk.css
    old = "\n".join(f"@define-color {k.replace('-', '_')}_color {v};" for k, v in pairs)
    new = "\n".join(f"    --{k}-color: {v};" for k, v in pairs)
    write(f"{CONF}/gtk-3.0/gtk.css", head + old + "\n")
    write(f"{CONF}/gtk-4.0/gtk.css", head + ":root {\n" + new + "\n}\n\n"
          "/* Lo mismo con nombres antiguos, para libadwaita < 1.6 */\n" + old + "\n")


def gen_ghostty(name, t):
    term = t["term"]
    pal = "\n".join(f"palette = {i}={c}" for i, c in enumerate(term["colors"]))
    write(f"{CONF}/ghostty/themes/current", f"""# {HEADER.format(name)}
{pal}
background = {term["background"]}
foreground = {term["foreground"]}
cursor-color = {term["cursor"]}
cursor-text = {term["background"]}
selection-background = {term["selection_background"]}
selection-foreground = {term["selection_foreground"]}
""")


def gen_qt(name, t):
    g, ui, c = t["gtk"], t["ui"], t["term"]["colors"]
    fg, dim = g["fg"], c[8]
    # Fusion reliefs: in dark themes they come from the terminal palette; in
    # light ones (where colors[15] is the dark text) they are computed from the buttons
    if t.get("light"):
        light, midlight = "#ffffff", mix(g["card"], "#ffffff", 0.5)
        dark, mid, bright = mix(g["card"], fg, 0.45), mix(g["card"], fg, 0.3), "#ffffff"
    else:
        light, midlight, dark, mid, bright = c[15], c[7], ui["bg"], c[8], c[15]

    # qt6ct: the 22 QPalette roles in their order
    def roles(text):
        return ", ".join([text, g["card"], light, midlight, dark, mid, text, bright, text,
                          g["window"], g["headerbar"], "#000000", g["accentBg"], g["accentFg"],
                          c[6], ui["accent"], g["card"], g["window"], g["headerbar"], fg, dim,
                          ui["accent"]])
    write(f"{CONF}/qt6ct/colors/current.conf",
          f"; {HEADER.format(name)}\n[ColorScheme]\nactive_colors={roles(fg)}\n"
          f"disabled_colors={roles(dim)}\ninactive_colors={roles(fg)}\n")

    # KDE scheme (used by Dolphin and other KF6 apps)
    def kde(*hexes):
        return ",".join(str(int(x.lstrip("#")[i:i + 2], 16)) for x in hexes for i in (0, 2, 4))
    fgs = (f"DecorationFocus={kde(ui['accent'])}\nDecorationHover={kde(ui['accent'])}\n"
           f"ForegroundActive={kde(ui['accent'])}\nForegroundInactive={kde(dim)}\n"
           f"ForegroundLink={kde(c[6])}\nForegroundNegative={kde(c[1])}\n"
           f"ForegroundNeutral={kde(c[3])}\nForegroundPositive={kde(c[2])}\n"
           f"ForegroundVisited={kde(ui['accent'])}\n")
    def group(header, bg, alt, text=fg):
        return (f"[{header}]\nBackgroundAlternate={kde(alt)}\nBackgroundNormal={kde(bg)}\n"
                f"{fgs}ForegroundNormal={kde(text)}\n\n")
    colors = (
        group("Colors:Button", g["card"], g["headerbar"])
        + group("Colors:Complementary", g["window"], g["card"])
        + group("Colors:Header", g["headerbar"], g["window"])
        + group("Colors:Header][Inactive", g["window"], g["headerbar"])
        + group("Colors:Selection", g["accentBg"], g["accentBg"], g["accentFg"])
        + group("Colors:Tooltip", g["headerbar"], g["window"])
        + group("Colors:View", g["window"], g["card"])
        + group("Colors:Window", g["headerbar"], g["card"])
        + f"[WM]\nactiveBackground={kde(g['headerbar'])}\nactiveBlend={kde(ui['accent'])}\n"
          f"activeForeground={kde(fg)}\ninactiveBackground={kde(g['window'])}\n"
          f"inactiveBlend={kde(dim)}\ninactiveForeground={kde(dim)}\n"
    )
    write(f"{HOME}/.local/share/color-schemes/Theme.colors",
          f"# {HEADER.format(name)}\n[General]\nColorScheme=Theme\nName={tr('Current theme')}\n\n{colors}")

    # kdeglobals: the other sections are kept and only the color ones change
    path = f"{CONF}/kdeglobals"
    keep, skip = [], False
    for line in (open(path).read().splitlines() if os.path.exists(path) else []):
        if line.startswith("["):
            skip = line.startswith(("[Colors:", "[ColorEffects:", "[WM]"))
        if not skip:
            keep.append(line)
    write(path, "\n".join(keep).rstrip() + "\n\n" + colors)


def gen_fastfetch(name, t):
    # Blends each Pepe color with the accent at its same lightness. The less
    # saturated the accent, the stronger the tint (with basalt's grey it ends up almost greyscale).
    acc = rgb(t["ui"]["accent"])
    lum = lambda c: 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
    sat = (max(acc) - min(acc)) / max(max(acc), 1)
    k = 0.4 + 0.4 * (1 - sat)
    la = max(lum(acc), 1)

    def tint(m):
        c = [int(x) for x in m.group(2).split(";")]
        l = lum(c)
        out = [round(min(255, (1 - k) * x + k * a * l / la)) for x, a in zip(c, acc)]
        return f"{m.group(1)};2;{out[0]};{out[1]};{out[2]}m"

    src = f"{CONF}/fastfetch"
    for f in sorted(os.listdir(src)):
        if f.startswith("pepe-") and f.endswith(".txt"):
            text = open(f"{src}/{f}").read()
            write(f"{src}/themed/{f}", re.sub(r"\x1b\[(38|48);2;(\d+;\d+;\d+)m",
                                             lambda m: "\x1b[" + tint(m), text))


GENERATORS = [gen_hyprland, gen_hyprlock, gen_gtk, gen_qt, gen_fastfetch]
# Terminal ones go through gen_terminals(): with "Increase contrast" they get the
# theme passed through boost_contrast() (wasdjy-contrast calls them again when it changes)
TERMINAL_GENERATORS = [gen_ghostty, gen_btop, gen_fzf]


def gen_terminals(name, t):
    # Without the mode, CONTRAST_THEME is deleted and Neovim goes back to themes/current/theme.json
    tt = t
    if contrast_on():
        tt = boost_contrast(t)
        write_atomic(CONTRAST_THEME, json.dumps(tt, indent=2) + "\n")
    elif os.path.exists(CONTRAST_THEME):
        os.remove(CONTRAST_THEME)
    for gen in TERMINAL_GENERATORS:
        gen(name, tt)


# ── Notify the programs that are already open ─────────────

def sync_profile():
    # wasdjy-config adjusts the profile to the theme's lightness (see its sync_theme)
    if os.path.isfile(f"{BIN}/wasdjy-config"):
        load_script("wasdjy-config").sync_theme()


def reload_all():
    qs_theme_reload()
    run_quiet(["hyprctl", "reload"])  # also hyprbars and the mac/mac-light shadows


def reload_nvim(t):
    # Every open Neovim listens on $XDG_RUNTIME_DIR/nvim.<pid>.0
    if NO_RELOAD:
        return
    # background first: otherwise, going from a light theme to a dark one it would stay
    # on light and rose-pine, gruvbox, everforest... would load their light variant
    cs = t.get("nvim", "catppuccin")
    bg = "light" if t.get("light") else "dark"
    # Both Neovims (mini.nvim and lazyvim) use the "tema" colorscheme, which defines
    # MiniThemeReload() and re-reads theme.json on its own; if it's missing (another colorscheme
    # loaded from outside), background + the "nvim" field are sent
    expr = (f"exists('*MiniThemeReload') ? MiniThemeReload() : "
            f"execute(['set background={bg}', 'colorscheme {cs}'])")
    # All at once (previously one after another, and a hung one delayed the rest)
    procs = [subprocess.Popen(["nvim", "--server", sock, "--remote-expr", expr], **QUIET)
             for sock in glob.glob(f"{os.environ.get('XDG_RUNTIME_DIR', '/tmp')}/nvim.*.0")]
    for p in procs:
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            p.kill()  # dead socket of an nvim that didn't close cleanly


def apply(name):
    t = load_theme(name)
    tmp = CURRENT + ".tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(name, tmp)
    os.replace(tmp, CURRENT)
    for gen in GENERATORS:
        gen(name, t)
    gen_terminals(name, t)
    reload_terminals()
    reload_nvim(t)
    sync_profile()  # before reloading: Hyprland reads the new profile
    reload_all()
    notify(tr("Theme"), tr("Color theme"), t.get("name", name))


def print_list():
    # --list: the Quickshell theme menu (Super+T). Each row has its palette
    # (terminal background and text, accent and 6 ANSI colors) and whether it is light; the
    # theme.json files that can't be read are skipped
    cur = current_theme()
    for d in list_themes():
        try:
            j = load_theme(d)
            term, c = j["term"], j["term"]["colors"]
            print(json.dumps({"dir": d, "name": j.get("name", d), "cur": d == cur,
                              "light": bool(j.get("light")),
                              "bg": term["background"], "fg": term["foreground"],
                              "colors": [j["ui"]["accent"]] + c[1:7]}))
        except (OSError, ValueError, KeyError, IndexError):
            pass


def main():
    args = sys.argv[1:]
    if not args:
        cur = current_theme()
        for d in list_themes():
            print(("* " if d == cur else "  ") + d)
        return
    if args[0] == "--list":
        print_list()
        return
    name = current_theme() if args[0] == "--reapply" else args[0]
    if name not in list_themes():
        sys.exit(tr("There is no theme “%1”. Themes: %2", name, ", ".join(list_themes())))
    apply(name)


if __name__ == "__main__":
    main()
