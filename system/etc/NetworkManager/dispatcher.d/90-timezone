#!/bin/bash
# Automatic time zone: when connecting to a network, NetworkManager runs this as root
# ($1 = interface, $2 = action) and sets the time zone of the location given by the public IP.
# Privacy: sends your public IP to ipinfo.io (HTTPS), nothing else.
# With a VPN active it does nothing: it would give the VPN exit's zone.
# If it fails (no network, no answer or odd zone) it touches nothing and keeps whatever there was.

[[ $2 == up ]] || exit 0
nmcli -t -f TYPE connection show --active | grep -qxE 'vpn|wireguard|tun' && exit 0

tz="$(curl -fsS --max-time 8 --retry 2 --retry-connrefused https://ipinfo.io/timezone)" || exit 0
# Only a valid zone name (America/New_York): no odd paths, and it must exist in tzdata
[[ $tz =~ ^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$ && -f /usr/share/zoneinfo/$tz ]] || exit 0
[[ $tz == "$(timedatectl show -p Timezone --value)" ]] && exit 0
timedatectl set-timezone "$tz" && logger -t timezone "zona horaria: $tz"
